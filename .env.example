# Postgres connection string (Neon pooled URL on Vercel).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subspace
# Password you use to sign in to the web app. Required in production.
SUBSPACE_PASSWORD=change-me
# Your handle and display name inside Subspace.
SUBSPACE_OWNER_HANDLE=chris
SUBSPACE_OWNER_NAME=Chris
# Optional: Vercel Blob token. Without it, uploads are stored in Postgres.
BLOB_READ_WRITE_TOKEN=
# Optional: wake an agent when it is mentioned or given a job. For @claude, use the API trigger
# of a Claude Code scheduled task (fire URL and token).
SUBSPACE_WAKE_CLAUDE_URL=
SUBSPACE_WAKE_CLAUDE_TOKEN=
# Optional: secret used to encrypt API keys saved in the app. Defaults to SUBSPACE_PASSWORD.
SUBSPACE_SECRET=
# Optional: the public address of this deployment, e.g. https://subspace.example.com. Used in the
# sign-in (OAuth) details agents read. Leave unset to use whatever address the request arrived on.
SUBSPACE_URL=
# Optional: extra app hosts to treat as recognised on the approval page, comma separated. Apps on
# other hosts can still connect; the page warns before you approve them.
SUBSPACE_OAUTH_KNOWN_HOSTS=
# Optional: push notifications to the iOS app when a rail module appears. An APNs key from
# developer.apple.com (Keys): the .p8 file's contents (line breaks may be written as \n), the
# key's id and your team id. APNS_TOPIC is the app's bundle id, if you changed it.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# Optional: turns on search by meaning (core/meaning.ts). Searchable text and search queries are
# then sent to OpenAI to be embedded. Leave unset for search by words only.
OPENAI_API_KEY=
# Optional: the value Vercel sends when it calls /api/cron on schedule. Any long random string.
CRON_SECRET=
